# LLM API Keys
# GOOGLE_API_KEY: Get from https://aistudio.google.com
# Free tier: 20 requests/day per Google Cloud project. Note that the full
# pipeline (Stages 1-6) makes 8+ LLM calls per run. When quota is exhausted,
# create a new Google Cloud project in AI Studio for a fresh key rather than waiting.
GOOGLE_API_KEY=

# GROQ_API_KEY: Fallback provider (faster but stricter rate limits)
# Free tier OTPM limit makes it unsuitable as primary for multi-agent
# pipelines. Keep as backup for when Gemini quota is exhausted.
GROQ_API_KEY=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Target repo for PR creation, in "owner/repo" format (e.g. myorg/myrepo)
GITHUB_REPO=
# Branch the SDLC pipeline commits code to (head of the PR)
HEAD_BRANCH=sdlc/automated
# Branch to merge the PR into
BASE_BRANCH=main
# Set to "true" to skip all GitHub API calls during development.
# The pr_author_node will return a synthetic pr dict instead of opening a real PR.
DRY_RUN=true

# LangSmith Observability
# Sign up at https://smith.langchain.com to get an API key.
# Set LANGCHAIN_TRACING_V2=true to enable automatic tracing
# of all LangChain/LangGraph calls. No code changes needed.
# Set to false to disable tracing (e.g., during rate-limit
# debugging to reduce noise in logs).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sdlc-pipeline
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Pipeline Configuration
PIPELINE_VERSION=1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# AUTO_APPROVE: Set to "true" to auto-approve at the HITL gate.
# Use for testing and CI. Set to "false" in production to
# require human approval via the review UI (future step).
AUTO_APPROVE=true

# Server Configuration (for main.py / uvicorn)
HOST=0.0.0.0
PORT=8000

# MAX_REVISIONS: Maximum test-fix loop iterations per run.
MAX_REVISIONS=3
MAX_TEST_RETRIES=5

# RAG Configuration
# INDEX_PATH: Directory where the FAISS codebase index is stored.
# Build the index first: python build_index.py <path_to_codebase>
# Leave unset to use the default "codebase_index" directory.
INDEX_PATH=codebase_index
